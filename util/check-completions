#!/usr/bin/env python3
"""Measure tab-completion coverage for commands on PATH.

A command counts as covered when the shell/completer would handle TAB for it:

  * carapace has a spec or a bridged bash completion for it, or
  * zsh has a native completion function for it.

This is a registration check, not a per-command behaviour probe: it is fast,
deterministic, and catches the usual regression (a package bump drops or
renames a completion) without running every completion.

The baseline is the list of commands that were covered when it was last
updated. Commands that disappear from PATH are ignored; commands that stay
installed but lose their completion fail the check.

Usage:
  util/check-completions                 # check against the baseline
  util/check-completions --update        # rewrite the baseline
  util/check-completions --missing       # list uncovered commands
  util/check-completions --json          # machine-readable summary
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

BASELINE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "completion-baseline")
REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REPO_SPECS = os.path.join(REPO, "home", "carapace", "specs")
DELEGATES = os.path.join(REPO, "home", "carapace", "delegates.json")
GENERATED = os.path.join(REPO, "home", "carapace", "generated.json")
GENERATED_META = os.path.join(REPO, "home", "carapace", "generated-meta.json")
FILE_ONLY = os.path.join(REPO, "home", "carapace", "file-only.json")
DEFAULT_SPEC_DIRS = [
    REPO_SPECS,
    os.path.expanduser("~/.local/state/nix/profiles/home-manager/home-files/.config/carapace/specs"),
    os.path.expanduser("~/.config/carapace/specs"),
]

# Completions generated by the tool itself at build time (home/completions.nix)
# and sourced into zsh, so they are not visible to `compinit` alone.
GENERATOR_COMPLETIONS = {"opencode", "uvx", "warp-cli"}

# Helper binaries that systemd/desktop components invoke themselves; nobody
# types these and their arguments are not a user interface.
INTERNAL_COMMANDS = {
    "gimp-script-fu-interpreter-3.0",
    "mount.ddi",
    "mount.mstack",
    "mount.storage",
    "systemd-home-fallback-shell",
    "systemd-mstack",
    "systemd-mute-console",
    "systemd-pty-forward",
    "systemd-stdio-bridge",
}

ZSH_SCRIPT = r"""
for p in ${(z)NIX_PROFILES}; do
  fpath+=($p/share/zsh/site-functions $p/share/zsh/$ZSH_VERSION/functions $p/share/zsh/vendor-completions)
done
autoload -Uz compinit
compinit -u
print -l -- ${(k)_comps}
"""


def commands_on_path():
    seen = set()
    found = []
    for directory in os.environ.get("PATH", "").split(os.pathsep):
        if not directory:
            continue
        try:
            entries = os.listdir(directory)
        except OSError:
            continue
        for name in entries:
            if name in seen:
                continue
            path = os.path.join(directory, name)
            if os.path.isfile(path) and os.access(path, os.X_OK):
                seen.add(name)
                found.append(name)
    return sorted(found)


def zsh_completions():
    zsh = shutil.which("zsh")
    if not zsh:
        sys.exit("check-completions: zsh not found on PATH")
    proc = subprocess.run([zsh, "-f", "-c", ZSH_SCRIPT], capture_output=True, text=True)
    return {line for line in proc.stdout.splitlines() if line and not line.isspace()}


def carapace_completions(spec_dirs):
    carapace = shutil.which("carapace")
    if not carapace:
        sys.exit("check-completions: carapace not found on PATH")
    env = dict(os.environ)
    env.setdefault("CARAPACE_BRIDGES", "bash")
    with tempfile.TemporaryDirectory() as config_home:
        # Measure the specs in this repo, not whatever is deployed in ~/.config.
        specs = os.path.join(config_home, "carapace", "specs")
        os.makedirs(specs)
        seen = {}
        for directory in spec_dirs:
            try:
                entries = os.listdir(directory)
            except OSError:
                continue
            for name in entries:
                if name.endswith(".yaml"):
                    seen[name] = os.path.join(directory, name)
        for name, source in seen.items():
            os.symlink(source, os.path.join(specs, name))
        try:
            with open(GENERATED) as handle:
                manifest = json.load(handle)
        except FileNotFoundError:
            manifest = {}
        for name, body in manifest.items():
            target = os.path.join(specs, name + ".yaml")
            if os.path.lexists(target):
                os.unlink(target)
            with open(target, "w") as handle:
                json.dump({"name": name, **body}, handle)
        env["XDG_CONFIG_HOME"] = config_home
        proc = subprocess.run([carapace, "_carapace", "zsh"], capture_output=True, text=True, env=env)
    match = re.search(r"^compdef _carapace_completer (.*)$", proc.stdout, re.MULTILINE)
    if not match:
        sys.exit("check-completions: could not parse carapace compdef list")
    return set(re.findall(r'"([^"]+)"', match.group(1)))


def delegated_completions(available):
    """Aliases served by a canonical completer through the zsh delegate."""
    try:
        with open(DELEGATES) as handle:
            mapping = json.load(handle)
    except FileNotFoundError:
        return set()
    names = set()
    for canonical, aliases in mapping.items():
        if canonical in available:
            names.update(aliases)
    return names


def read_baseline():
    try:
        with open(BASELINE) as handle:
            return {line.strip() for line in handle if line.strip()}
    except FileNotFoundError:
        return set()


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--update", action="store_true", help="rewrite the baseline with current coverage")
    parser.add_argument("--missing", action="store_true", help="print uncovered commands")
    parser.add_argument("--json", action="store_true", help="print a JSON summary")
    parser.add_argument("--specs", action="append", metavar="DIR", help="spec directory to include (repeatable; replaces the defaults)")
    args = parser.parse_args()

    installed = set(commands_on_path()) - INTERNAL_COMMANDS
    spec_dirs = args.specs or DEFAULT_SPEC_DIRS
    available = zsh_completions() | carapace_completions(spec_dirs)
    covered = available & installed
    covered |= delegated_completions(available) & installed
    covered |= GENERATOR_COMPLETIONS & installed
    try:
        with open(FILE_ONLY) as handle:
            covered |= set(json.load(handle)) & installed
    except FileNotFoundError:
        pass
    uncovered = sorted(installed - covered)
    baseline = read_baseline()
    regressions = sorted((baseline & installed) - covered)
    additions = sorted(covered - baseline)

    if args.update:
        with open(BASELINE, "w") as handle:
            handle.write("".join(f"{name}\n" for name in sorted(covered)))

    if args.missing:
        print("\n".join(uncovered))

    generated_meta = {}
    try:
        with open(GENERATED_META) as handle:
            generated_meta = json.load(handle)
    except FileNotFoundError:
        pass
    generated = {n: generated_meta[n] for n in generated_meta if n in covered}
    generated_with_flags = sum(1 for m in generated.values() if m.get("source") == "help" and m.get("flags", 0) > 0)
    generated_file = len(generated) - generated_with_flags

    summary = {
        "installed": len(installed),
        "covered": len(covered),
        "uncovered": len(uncovered),
        "baseline": len(baseline),
        "regressions": regressions,
        "additions": additions,
        "updated": args.update,
        "generated_with_flags": generated_with_flags,
        "generated_file_only": generated_file,
    }

    if args.json:
        print(json.dumps(summary, indent=2))
    elif not args.missing:
        percent = 100 * len(covered) / len(installed) if installed else 0
        print(f"{len(covered)}/{len(installed)} commands covered ({percent:.1f}%)")
        if generated:
            print(f"generated specs: {generated_with_flags} with flags, {generated_file} file-only")
        if args.update:
            print(f"baseline written: {len(covered)} commands")
        if additions:
            print(f"new since baseline: {len(additions)}")
        if regressions:
            print(f"REGRESSIONS: {len(regressions)}", file=sys.stderr)
            for name in regressions:
                print(f"  {name}", file=sys.stderr)

    if regressions:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
